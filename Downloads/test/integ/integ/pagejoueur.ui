      <string notr="true">QLabel {
    /* Style du texte */
    font: 16pt &quot;Haettenschweiler&quot;;
    color: rgb(46, 52, 76);  /* Couleur de texte bleu foncé */
    qproperty-alignment: AlignCenter;  /* Texte centré */
    
    /* Arrière-plan */
    background-color: white;  /* Fond blanc */
    
    /* Bordures */
    border: 1.5px solid #2E344C;  /* Bordure bleu foncé épaissie (3px au lieu de 2px) */
    border-radius: 10px;  /* Coins arrondis */
    
    /* Espacements */
    padding: 8px 12px;  /* Plus d'espace à l'intérieur (8px haut/bas, 12px gauche/droite) */
    margin: 2px;  /* Marge extérieure légère */
}</string>
