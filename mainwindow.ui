      <property name="styleSheet">
       <string notr="true">QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 1px;
    border-left-color: #2E344C;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}


QComboBox QAbstractItemView {
    background-color: #FDF6D0;
    color: #2E344C;
    selection-background-color: #2E344C;
    selection-color: #FDF6D0;
    border: 2px solid #2E344C;
    border-radius: 5px;
    padding: 5px;
}

QComboBox:on { /* Style lorsque le menu déroulant est ouvert */
    border: 2px solid #4C566A;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    /* Pas d'image, on utilise la flèche native mais on change sa couleur */
}

QComboBox::down-arrow:on {
    image: none; /* Désactive toute icône personnalisée */
    color: #2E344C; /* Couleur de la flèche (bleu foncé) */
}</string>
