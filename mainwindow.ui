      <property name="styleSheet">
       <string notr="true">QTableWidget {
    background-color: #FDF6D0;
    color: #2E344C;
    gridline-color: #2E344C;
    border: 2px solid #2E344C;
    border-radius: 10px;
}

QHeaderView::section {
    background-color: #2E344C;
    color: #FDF6D0;
    padding: 5px;
    border: 1px solid #2E344C;
}

QTableWidget QTableCornerButton::section {
    background-color: #2E344C;
}

QTableWidget::item {
    padding: 5px;
    border: 1px solid #2E344C;
}

QTableWidget::item:selected {
    background-color: #2E344C;
    color: #FDF6D0;
}
ui-&gt;tab-&gt;setStyleSheet(
    &quot;QTableWidget {&quot;
    &quot;   width: 600px;&quot;   // Set the width of the table
    &quot;   height: 300px;&quot;  // Set the height of the table
    &quot;}&quot;
);
</string>
